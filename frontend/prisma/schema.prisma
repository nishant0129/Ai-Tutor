datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String       @id @default(cuid())
  username   String
  email      String       @unique
  password   String
  createdAt  DateTime     @default(now())
  interviews Interview[]
  jobs       Job[]
  studyTasks StudyTask[]
  resume     Resume?
}

model Interview {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  company   String
  role      String
  date      String
  status    String
  createdAt DateTime @default(now())
}

model Job {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  company   String
  role      String
  status    String
  createdAt DateTime @default(now())
}

model StudyTask {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  date      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Resume {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  name       String
  title      String
  summary    String
  skills     String
  experience String
  jobTarget  String?
  style      String?
  updatedAt  DateTime @updatedAt
}
